datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma/client"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("Session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@unique([identifier, value])
  @@map("verification")
}

model Project {
  id                String             @id @default(cuid())
  projectId         String             @unique @default(cuid())
  domain            String             @unique
  ownerId           String
  name              String
  status            ProjectStatus      @default(ACTIVE)
  timeZone          String             @default("UTC")
  dataRetentionDays Int                @default(30)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  domains           ProjectDomain[]
  visitors          Visitor[]
  analyticsSessions AnalyticsSession[]
  events            Event[]
  dailyMetrics      DailyMetric[]

  @@index([ownerId])
}

enum ProjectStatus {
  ACTIVE
  PAUSED
}

model ProjectDomain {
  id         String   @id @default(cuid())
  projectId  String
  domain     String
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, domain])
  @@index([domain])
}

model Visitor {
  id              String   @id @default(cuid())
  projectId       String
  beaconVisitorId String
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  sessionCount    Int      @default(0)
  lastHost        String?
  lastDevice      String?
  lastBrowser     String?
  language        String?

  project  Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sessions AnalyticsSession[]

  @@unique([projectId, beaconVisitorId])
  @@index([projectId, lastSeenAt])
}

model AnalyticsSession {
  id              String    @id @default(cuid())
  projectId       String
  beaconSessionId String    @unique
  visitorId       String
  beaconVisitorId String
  startedAt       DateTime  @default(now())
  lastActivityAt  DateTime  @default(now())
  endedAt         DateTime?

  host         String?
  landingPage  String?
  device       String?
  browser      String?
  screenWidth  Int?
  screenHeight Int?
  language     String?
  country      String?
  city         String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  visitor Visitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  events  Event[]

  @@index([projectId, lastActivityAt])
  @@index([projectId, beaconVisitorId])
  @@index([visitorId])
  @@map("sessions")
}

model Event {
  id              String       @id @default(cuid())
  projectId       String
  sessionId       String?
  beaconSessionId String?
  beaconVisitorId String?
  eventType       EventType
  eventName       String?
  pagePath        String?
  host            String?
  eventTime       DateTime     @default(now())
  browser         String?
  deviceType      String?
  language        String?
  screenWidth     Int?
  screenHeight    Int?
  country         String?
  city            String?
  url             String?
  method          String?
  statusCode      Int?
  durationMs      Int?
  valueMs         Float?
  rating          VitalRating?

  errorMessage  String?
  errorFilename String?
  errorLine     Int?
  errorColumn   Int?

  metadata Json?

  project Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  session AnalyticsSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([projectId, eventTime])
  @@index([sessionId])
  @@index([projectId, eventType, eventTime])
  @@index([projectId, beaconVisitorId, eventTime])
}

enum EventType {
  PAGE_VIEW
  SESSION_START
  CUSTOM
  API_REQUEST
  WEB_VITAL
  JAVASCRIPT_ERROR
  PROMISE_ERROR
}

enum VitalRating {
  good
  needs_improvement
  poor
}

model DailyMetric {
  id               String   @id @default(cuid())
  projectId        String
  date             DateTime
  pageviews        Int      @default(0)
  sessions         Int      @default(0)
  uniqueVisitors   Int      @default(0)
  customEvents     Int      @default(0)
  apiRequests      Int      @default(0)
  errorCount       Int      @default(0)
  avgApiDurationMs Int?
  p95ApiDurationMs Int?
  lcpP75Ms         Float?
  clsP75           Float?
  inpP75Ms         Float?
  fcpP75Ms         Float?
  ttfbP75Ms        Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, date])
  @@index([projectId, date])
}
